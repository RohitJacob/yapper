# Generate a unique secret with: openssl rand -hex 32
YAPPER_API_KEY=replace-with-a-random-secret-at-least-32-characters
YAPPER_MODE=simulation
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/yapper.sqlite
MAX_CONCURRENT_CALLS=2

# Live mode requires HTTPS, an explicit destination allowlist, and provider keys.
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_NUMBERS=+15555550123
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEEPGRAM_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
